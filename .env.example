
# Application
NODE_ENV=development
SERVER_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Password pepper
PEPPER=replace-with-a-random-secret-at-least-32-characters-long

JWT_PRIVATE_KEY_BASE64=base64-encoded-pem-private-key
JWT_PUBLIC_KEY_BASE64=base64-encoded-pem-public-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=15d
JWT_ISSUER=generic-roleplay-api
JWT_AUDIENCE=generic-roleplay-client

# Bounded password hashing; two active hashes and at most sixteen queued.
HASH_CONCURRENCY=2
HASH_QUEUE_LIMIT=16
DATABASE_QUERY_TIMEOUT_MS=5000
# Shared authentication request budget per minute (maximum 1200).
AUTH_GLOBAL_LIMIT=1200
# Comma-separated trusted proxy IPs/CIDRs; empty means no trusted proxy.
TRUSTED_PROXY_CIDRS=
